# Local registry database. Keep real credentials in an uncommitted .env file.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vaultos

# Server-side Ethereum Sepolia RPC. Use a provider URL you control when this app is deployed.
# The example endpoint is public and contains no API key.
VAULTOS_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
VAULTOS_CHAIN_ID=11155111

# Deployed VaultFactory on Ethereum Sepolia. A different factory on chain 11155111 is rejected.
VAULTOS_FACTORY_ADDRESS=0x41AF576177D3955fdCb1A9e074A864E6F14A9D4B

# Optional browser read endpoint. Leave this unset to use the public default in code.
# Do not put a secret API key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_VAULTOS_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
